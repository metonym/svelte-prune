{
  "name": "svelte-prune",
  "version": "0.13.2",
  "description": "Ship only the Svelte library code your app renders.",
  "license": "MIT",
  "author": "Eric Liu (https://github.com/metonym)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-prune.git"
  },
  "homepage": "https://github.com/metonym/svelte-prune",
  "bugs": "https://github.com/metonym/svelte-prune/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./webpack": {
      "types": "./webpack.d.ts",
      "default": "./webpack.js"
    },
    "./internal": {
      "types": "./internal.d.ts",
      "default": "./internal.js"
    },
    "./internal/analysis": {
      "types": "./internal-analysis.d.ts",
      "default": "./internal-analysis.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "devDependencies": {
    "caligula": "0.4.0",
    "svelte-ast": "0.12.1"
  }
}
